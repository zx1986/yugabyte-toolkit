{
  "uid": "yb-sre-query-insights",
  "title": "YugabyteDB SRE - Query Insights",
  "tags": [
    "YugabyteDB",
    "SRE",
    "queries",
    "ysql"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "dbcluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(node_prefix)",
        "label": "YugabyteDB Cluster",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Live Active Queries",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "ysql"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT datname, usename, state, client_addr::text AS client_addr,\n                               now() - query_start AS elapsed, wait_event_type, wait_event,\n                               left(query, 500) AS query\n                        FROM pg_stat_activity\n                        WHERE pid <> pg_backend_pid()\n                          AND state <> 'idle'\n                        ORDER BY query_start NULLS LAST\n                        LIMIT 50;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "Long Running Sessions",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "ysql"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT datname, usename, state, client_addr::text AS client_addr,\n                               now() - query_start AS elapsed, left(query, 500) AS query\n                        FROM pg_stat_activity\n                        WHERE query_start IS NOT NULL\n                          AND now() - query_start > interval '5 seconds'\n                        ORDER BY elapsed DESC\n                        LIMIT 50;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Waiting or Blocked Sessions",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "ysql"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT datname, usename, state, wait_event_type, wait_event,\n                               now() - query_start AS elapsed, left(query, 500) AS query\n                        FROM pg_stat_activity\n                        WHERE wait_event IS NOT NULL\n                           OR wait_event_type IS NOT NULL\n                        ORDER BY elapsed DESC NULLS LAST\n                        LIMIT 50;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Slow Statements by Mean Time",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "ysql"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.rolname AS user_name, calls,\n                               round(total_time::numeric, 2) AS total_time_ms,\n                               round(mean_time::numeric, 2) AS mean_time_ms,\n                               rows, left(query, 500) AS query\n                        FROM pg_stat_statements s\n                        JOIN pg_roles r ON r.oid = s.userid\n                        ORDER BY mean_time DESC\n                        LIMIT 20;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
