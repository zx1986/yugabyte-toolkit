      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT databasename, backend_pid, termination_reason,\n                               query_start_time, query_end_time,\n                               left(query_text, 500) AS query_text\n                        FROM yb_terminated_queries\n                        ORDER BY query_end_time DESC\n                        LIMIT 50;",
