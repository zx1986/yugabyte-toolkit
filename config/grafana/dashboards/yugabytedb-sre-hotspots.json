          },
          "expr": "topk(10, sum by (table_name) (irate(rpc_latency_count{node_prefix=\"$dbcluster\",export_type=\"tserver_export\",saved_name=\"handler_latency_yb_tserver_TabletServerService_Write_count\",table_name!=\"\"}[5m])))",
          "legendFormat": "{{table_name}}",
          "refId": "A"
        }
